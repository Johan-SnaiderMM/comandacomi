# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local.
# Este archivo solo lista los NOMBRES de las variables, sin valores reales.

# --- Marca (configurable; la marca final aún no está decidida) ---
NEXT_PUBLIC_MARCA_NOMBRE=Comanda
NEXT_PUBLIC_MARCA_LEMA=Pedidos, fiado y cierre del día en tu celular
# WhatsApp de quien vende la app (E.164 sin "+", ej. 573001234567). Activa el botón "Quiero esta app".
NEXT_PUBLIC_CONTACTO_WHATSAPP=

# --- Supabase (Project Settings > API) ---
# La URL y la anon key son públicas por diseño: la seguridad la da RLS, no ocultar estas dos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Usuario de la demo (SOLO servidor; nunca con prefijo NEXT_PUBLIC_) ---
# El usuario se crea a mano en Supabase > Authentication > Users (ver README).
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Desarrollo local sin Supabase ---
# "local" usa una base PGlite en .local/ con las mismas migraciones (solo fuera de producción).
DEMO_BD=
